{
  "name": "vread",
  "version": "0.1.0",
  "description": "Local-first Vietnamese document reader for JavaScript",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.lib.config.ts && vite build --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@zxing/browser": "^0.2.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
